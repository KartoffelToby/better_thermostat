{
  "entity": {
    "sensor": {
      "temp_slope": {
        "default": "mdi:chart-line"
      },
      "heating_power": {
        "default": "mdi:thermometer-plus"
      },
      "heat_loss": {
        "default": "mdi:thermometer-minus"
      },
      "virtual_temp": {
        "default": "mdi:thermometer-auto"
      },
      "mpc_gain": {
        "default": "mdi:thermometer-plus"
      },
      "mpc_loss": {
        "default": "mdi:thermometer-minus"
      },
      "mpc_ka": {
        "default": "mdi:home-thermometer-outline"
      },
      "mpc_v2_virtual_temp": {
        "default": "mdi:thermometer-auto"
      },
      "mpc_v2_coupling": {
        "default": "mdi:heat-wave"
      },
      "mpc_v2_disturbance": {
        "default": "mdi:thermometer-minus"
      },
      "mpc_v2_predicted_disturbance": {
        "default": "mdi:chart-line"
      },
      "mpc_v2_room_time_constant": {
        "default": "mdi:home-clock-outline"
      },
      "pid_output": {
        "default": "mdi:valve"
      },
      "pid_error": {
        "default": "mdi:thermometer-alert"
      },
      "sustained_heat_loss_detection": {
        "default": "mdi:shield-search",
        "state": {
          "monitoring": "mdi:shield-search",
          "paused": "mdi:pause-circle-outline",
          "loss_above_target": "mdi:thermometer-chevron-up",
          "checking": "mdi:timer-sand",
          "detected": "mdi:alert-circle-outline"
        }
      }
    },
    "binary_sensor": {
      "heat_source_detected": {
        "default": "mdi:fire",
        "state": {
          "on": "mdi:fire",
          "off": "mdi:fire-off"
        }
      },
      "heat_loss_detected": {
        "default": "mdi:weather-windy",
        "state": {
          "on": "mdi:weather-windy",
          "off": "mdi:weather-windy-variant"
        }
      },
      "suspected_open_window": {
        "default": "mdi:window-open-variant",
        "state": {
          "on": "mdi:window-open-variant",
          "off": "mdi:window-closed-variant"
        }
      },
      "sustained_heat_loss": {
        "default": "mdi:door-open",
        "state": {
          "on": "mdi:door-open",
          "off": "mdi:door-closed"
        }
      },
      "no_heat_delivery": {
        "default": "mdi:radiator-off",
        "state": {
          "on": "mdi:radiator-off",
          "off": "mdi:radiator"
        }
      },
      "valve_stuck_open": {
        "default": "mdi:pipe-leak",
        "state": {
          "on": "mdi:pipe-leak",
          "off": "mdi:pipe-valve"
        }
      }
    },
    "switch": {
      "release_devices": {
        "default": "mdi:hand-back-right",
        "state": {
          "off": "mdi:hand-back-right-off"
        }
      },
      "release_trv": {
        "default": "mdi:hand-back-right",
        "state": {
          "off": "mdi:hand-back-right-off"
        }
      },
      "release_trv_no_trv": {
        "default": "mdi:hand-back-right",
        "state": {
          "off": "mdi:hand-back-right-off"
        }
      },
      "child_lock": {
        "default": "mdi:account-lock",
        "state": {
          "off": "mdi:account-lock-open"
        }
      },
      "child_lock_no_trv": {
        "default": "mdi:account-lock",
        "state": {
          "off": "mdi:account-lock-open"
        }
      },
      "pid_auto_tune": {
        "default": "mdi:magic-staff"
      },
      "pid_auto_tune_no_trv": {
        "default": "mdi:magic-staff"
      },
      "pause_learning": {
        "default": "mdi:school",
        "state": {
          "on": "mdi:pause-circle"
        }
      },
      "window_detection": {
        "default": "mdi:window-open-variant"
      },
      "anomaly_detection": {
        "default": "mdi:shield-search",
        "state": {
          "on": "mdi:shield-check",
          "off": "mdi:shield-off-outline"
        }
      },
      "anomaly_suppression": {
        "default": "mdi:window-shutter-alert"
      }
    }
  },
  "services": {
    "reset_heating_power": {
      "service": "mdi:restore"
    },
    "reset_pid_learnings": {
      "service": "mdi:restore"
    },
    "run_valve_maintenance": {
      "service": "mdi:valve"
    }
  }
}
