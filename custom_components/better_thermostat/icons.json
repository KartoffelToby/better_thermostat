        "default": "mdi:thermometer-minus"
      },
      "virtual_temp": {
        "default": "mdi:thermometer-auto"
      },
      "mpc_gain": {
        "default": "mdi:thermometer-plus"
      },
      "mpc_loss": {
        "default": "mdi:thermometer-minus"
      },
      "mpc_ka": {
        "default": "mdi:home-thermometer-outline"
      },
      "mpc_v2_virtual_temp": {
        "default": "mdi:thermometer-auto"
      },
      "mpc_v2_coupling": {
        "default": "mdi:heat-wave"
      },
      "mpc_v2_disturbance": {
        "default": "mdi:thermometer-minus"
      },
      "mpc_v2_room_time_constant": {
        "default": "mdi:home-clock-outline"
